// Static RROs of the stock 305 vendor partition, /vendor/overlay/<name>/<name>.apk (112 KB in total, from
// the stock vendor.img). They cannot be PRODUCT_COPY_FILES (the build refuses prebuilt APKs there) and
// android_app_import always installs under <partition>/app, so they are prebuilt_overlay modules.
//
// The files live here rather than in vendor/xiaomi/emerald: that repository is regenerated by
// extract-files.py, which deletes everything it does not generate itself, and extract-utils can only emit
// a plain copy for an APK. Because they are copied here, they are not in proprietary-files.txt either.
prebuilt_overlay {
    name: "emerald_overlay_CellbroadcastUIResOverlay",
    src: "CellbroadcastUIResOverlay.apk",
    filename: "CellbroadcastUIResOverlay.apk",
    sub_dir: "CellbroadcastUIResOverlay",
    soc_specific: true,
}

prebuilt_overlay {
    name: "emerald_overlay_FrameworkResOverlay",
    src: "FrameworkResOverlay.apk",
    filename: "FrameworkResOverlay.apk",
    sub_dir: "FrameworkResOverlay",
    soc_specific: true,
}

prebuilt_overlay {
    name: "emerald_overlay_FrameworkResOverlayExt",
    src: "FrameworkResOverlayExt.apk",
    filename: "FrameworkResOverlayExt.apk",
    sub_dir: "FrameworkResOverlayExt",
    soc_specific: true,
}

