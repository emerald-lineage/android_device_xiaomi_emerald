// The three symlinks of the stock 305 vendor.img whose names cannot be used as a soong module name
// (`@`), so extract-utils leaves them out and they are written by hand here. Same installed locations
// and targets as the stock image; the other symlinks come from the blobs. `/vendor/bin/[` is not here
// any more: the platform's toybox_vendor installs it (25.11, the platform owns what it installs).
install_symlink {
    name: "vendor_camera_provider_2_6_impl",
    soc_specific: true,
    installed_location: "lib64/hw/android.hardware.camera.provider@2.6-impl-mediatek.so",
    symlink_target: "/vendor/lib64/hw/mt6789/android.hardware.camera.provider@2.6-impl-mediatek.so",
}

install_symlink {
    name: "vendor_camera_ccap_1_0_impl",
    soc_specific: true,
    installed_location: "lib64/hw/vendor.mediatek.hardware.camera.ccap@1.0-impl.so",
    symlink_target: "/vendor/lib64/hw/mt6789/vendor.mediatek.hardware.camera.ccap@1.0-impl.so",
}

install_symlink {
    name: "vendor_camera_isphal_aidl_1_0_impl",
    soc_specific: true,
    installed_location: "lib64/hw/vendor.mediatek.hardware.camera.isphal_aidl@1.0-impl.so",
    symlink_target: "/vendor/lib64/hw/mt6789/vendor.mediatek.hardware.camera.isphal_aidl@1.0-impl.so",
}

// The two symlinks of the stock vendor.img that extract-utils leaves out because their targets are not
// files of the partition (a directory, and a path on vendor_dlkm).
install_symlink {
    name: "vendor_firmware_sensor",
    soc_specific: true,
    installed_location: "firmware/sensor",
    symlink_target: "/vendor/etc/imgsensor/mt6789",
}

install_symlink {
    name: "vendor_lib_modules",
    soc_specific: true,
    installed_location: "lib/modules",
    symlink_target: "/vendor_dlkm/lib/modules",
}
