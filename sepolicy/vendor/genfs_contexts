genfscon sysfs /devices/platform/soc/soc:hq_chg_manager/power_supply/usb/real_type    u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/soc:xm_pd_adapter/Charging_Adapter/pd_adapter/pdo2 u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/soc:xm_pd_adapter/Charging_Adapter/pd_adapter/adapter_id u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/soc:xm_pd_adapter/Charging_Adapter/pd_adapter/adapter_svid u:object_r:sysfs_power_supply:s0
