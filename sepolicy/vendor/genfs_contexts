# Точечно из xaveroprjkt/device_xiaomi_emerald (Apache-2.0), сверено со стоком 305: в стоке эти
# узлы размечены sysfs_battery_supply/sysfs_usb_supply/sysfs_tp_fodstatus — типов, которых у нас
# нет; здесь те же узлы получают существующие у нас sysfs_power_supply / новый vendor_fingerprint_sysfs.
# Взяты только узлы, нужные B21/B23; 90 «wakeup»-строк источника не берём.

# mi_thermald: конфиг MTK thermal
genfscon sysfs /devices/virtual/thermal/thermal_message/sconfig                    u:object_r:vendor_sysfs_thermalconfig:s0

# fingerprint: статус FOD (сток 305: sysfs_tp_fodstatus)
genfscon sysfs /devices/virtual/touch/touch_dev/fod_press_status                   u:object_r:vendor_fingerprint_sysfs:s0

# displayfeature (системные узлы mi_display)
genfscon sysfs /devices/virtual/mi_display/disp_feature/disp-DSI-0/disp_param       u:object_r:vendor_displayfeature_sysfs:s0
genfscon sysfs /class/mi_display/disp-DSI-0/panel_info                              u:object_r:vendor_displayfeature_sysfs:s0

# charging: hq_chg_manager / xm_pd_adapter / sc-cp (batterysecret, mi_thermald)
