genfscon sysfs /devices/platform/soc/soc:xm_pd_adapter/Charging_Adapter/pd_adapter/request_vdm_cmd u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/11f00000.i2c/i2c-7/7-0055/power_supply/bms    u:object_r:sysfs_power_supply:s0
