genfscon sysfs /devices/platform/soc/soc:hq_chg_manager/power_supply/usb             u:object_r:sysfs_power_supply:s0
genfscon sysfs /devices/platform/soc/soc:hq_chg_manager/power_supply/charger/type    u:object_r:sysfs_power_supply:s0
