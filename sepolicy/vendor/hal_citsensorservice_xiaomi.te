# Взято из xaveroprjkt/device_xiaomi_emerald (ветка lineage-24.0, sepolicy/vendor/hal_citsensorservice_xiaomi.te),
# Apache-2.0, авторство сохранено.
# Отличие от источника: в стоке 305 сервис AIDL (`vendor.xiaomi.sensor.citsensorservice.aidl`), а не
# HIDL @2.0, поэтому домен регистрируется через hal_server_domain (даёт
# vendor_hal_citsensorservice_xiaomi_service, как в vendor_service_contexts стока) — HIDL-строки источника
# оставлены безвредными, но не нужны.
type vendor_hal_citsensorservice_xiaomi_default, domain;
type vendor_hal_citsensorservice_xiaomi_default_exec, exec_type, file_type, vendor_file_type;
type vendor_hal_citsensorservice_xiaomi_hwservice, hwservice_manager_type;
# Имя типа — как в vendor_service_contexts стока 305 (…ICitSensorService/default).
type vendor_hal_citsensorservice_xiaomi_service, service_manager_type;

allow vendor_hal_citsensorservice_xiaomi_client vendor_hal_citsensorservice_xiaomi_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_client vendor_hal_citsensorservice_xiaomi_server:binder { call transfer };
allow vendor_hal_citsensorservice_xiaomi_client vendor_hal_citsensorservice_xiaomi_server:binder transfer;
allow vendor_hal_citsensorservice_xiaomi_client vendor_hal_citsensorservice_xiaomi_server:fd *;
allow vendor_hal_citsensorservice_xiaomi_default dri_device:dir { open read search };
allow vendor_hal_citsensorservice_xiaomi_default dri_device:chr_file { ioctl open read write };
allow vendor_hal_citsensorservice_xiaomi_default fwk_sensor_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default gpu_device:dir { open read search };
allow vendor_hal_citsensorservice_xiaomi_default gpu_device:chr_file { ioctl open read write };
allow vendor_hal_citsensorservice_xiaomi_default hal_graphics_allocator_default:binder call;
allow vendor_hal_citsensorservice_xiaomi_default hal_graphics_allocator_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default hal_graphics_composer_default:binder transfer;
allow vendor_hal_citsensorservice_xiaomi_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default hal_sensors_default:binder { call transfer };
allow vendor_hal_citsensorservice_xiaomi_default hf_manager_device:chr_file rw_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default input_device:dir { open read search };
allow vendor_hal_citsensorservice_xiaomi_default input_device:chr_file { ioctl open read write };
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:dir search;
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:file create_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default mtk_hal_composer_ext_hwservice:hwservice_manager find;
allow vendor_hal_citsensorservice_xiaomi_default nvcfg_file:file create_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default nvcfg_file:dir create_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default persist_data_file:dir create_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default persist_data_file:file create_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default sysfs_leds:dir { open search };
allow vendor_hal_citsensorservice_xiaomi_default sysfs_leds:file { open read write };
allow vendor_hal_citsensorservice_xiaomi_default system_server:binder call;
allow vendor_hal_citsensorservice_xiaomi_default system_server:binder transfer;
allow vendor_hal_citsensorservice_xiaomi_server vendor_hal_citsensorservice_xiaomi_client:binder transfer;
allow vendor_hal_citsensorservice_xiaomi_server vendor_hal_citsensorservice_xiaomi_client:binder { call transfer };
allow vendor_hal_citsensorservice_xiaomi_server vendor_hal_citsensorservice_xiaomi_client:fd *;
allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_sysfs:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_sysfs:file rw_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default dmabuf_system_heap_device:chr_file rw_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default dmabuf_system_secure_heap_device:chr_file { getattr ioctl lock open read watch watch_reads };
allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_device:chr_file { ioctl open read write };

hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_allocator)
hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_composer)
hal_server_domain(vendor_hal_citsensorservice_xiaomi_default, vendor_hal_citsensorservice_xiaomi)
# Регистрация AIDL-сервиса под типом из vendor_service_contexts стока.
add_service(vendor_hal_citsensorservice_xiaomi_default, vendor_hal_citsensorservice_xiaomi_service)
init_daemon_domain(vendor_hal_citsensorservice_xiaomi_default)
r_dir_file(vendor_hal_citsensorservice_xiaomi_default, mnt_vendor_file)
