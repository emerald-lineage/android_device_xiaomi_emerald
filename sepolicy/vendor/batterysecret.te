# Взято из xaveroprjkt/device_xiaomi_emerald (ветка lineage-24.0, sepolicy/vendor/vendor_batterysecret.te),
# Apache-2.0, авторство сохранено. Отличие: домен назван `batterysecret`, как требует
# `seclabel u:r:batterysecret:s0` в стоковом init.batterysecret.rc (у них vendor_batterysecret).
# Сток 305: /vendor/bin/batterysecret, /vendor/bin/charger_region_server_bin → batterysecret_exec.
type batterysecret, domain;
type batterysecret_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(batterysecret)

wakelock_use(batterysecret)

r_dir_file(batterysecret, sysfs_batteryinfo)
rw_dir_file(batterysecret, sysfs_power_supply)
rw_dir_file(batterysecret, sysfs_usb_nonplat)

allow batterysecret self:capability {
    chown
    fsetid
};

allow batterysecret kmsg_device:chr_file rw_file_perms;

allow batterysecret self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

set_prop(batterysecret, vendor_batterysecret_prop)
