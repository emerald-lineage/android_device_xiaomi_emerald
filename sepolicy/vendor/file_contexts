/(vendor|system/vendor)/bin/hw/android\.hardware\.usb-aidl-service\.mediatek    u:object_r:mtk_hal_usb_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.usb\.gadget-aidl-service\.mediatek    u:object_r:mtk_hal_usb_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.dolby\.media\.c2-default-service-dax    u:object_r:mediacodec_exec:s0
