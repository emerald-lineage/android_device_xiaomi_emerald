/(vendor|system/vendor)/bin/hw/android\.hardware\.bluetooth-service-mediatek    u:object_r:mtk_hal_bluetooth_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.boot-service\.mtk    u:object_r:hal_bootctl_default_exec:s0
