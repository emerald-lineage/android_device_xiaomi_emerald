# Домен стокового сервиса mi_ric (`/vendor/bin/MI_RIC`, сток 305: mi_ric.rc,
# 4 сервиса mi_ric_init/run/file/snapshot, у всех `seclabel u:r:mi_ric:s0`;
# class main, disabled, запуск по `sys.boot_completed=1` и `vendor.mi_ric.is.valid`).
# Заготовка B21: правила — только те, у которых все типы есть в нашей политике.
# Отброшены правила на vendor_mi_ric_prop, mi_ic_data_file, procfs_memory,
# gsort_block_device, sysfs_bootinfo (этих типов у нас нет) — см. отчёт.
type mi_ric, domain, mlstrustedsubject;
type mi_ric_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mi_ric)

r_dir_file(mi_ric, sysfs)
r_dir_file(mi_ric, sysfs_memory)

allow mi_ric console_device:chr_file rw_file_perms;
allow mi_ric init:unix_stream_socket connectto;
allow mi_ric property_socket:sock_file write;
allow mi_ric init:dir { getattr search };
allow mi_ric init:file r_file_perms;
allow mi_ric vendor_init:dir getattr;
allow mi_ric vendor_init:file read;
allow mi_ric kernel:dir { getattr search };
allow mi_ric kernel:file r_file_perms;
allow mi_ric proc:dir search;
allow mi_ric proc:file r_file_perms;
allow mi_ric proc_perf:file write;
allow mi_ric proc_uptime:file { read open };
allow mi_ric proc_meminfo:file r_file_perms;
allow mi_ric tmpfs:dir search;
allow mi_ric mnt_user_file:dir { search getattr };
allow mi_ric mnt_user_file:lnk_file read;
allow mi_ric storage_file:lnk_file read;
allow mi_ric shell_data_file:file read;
allow mi_ric sysfs_devices_block:dir search;
allow mi_ric sysfs_devices_system_cpu:file rw_file_perms;
allow mi_ric block_device:dir search;
allow mi_ric debugfs_tracing:dir r_dir_perms;
allow mi_ric debugfs_tracing:file rw_file_perms;
allow mi_ric mnt_vendor_file:dir { getattr search };
allow mi_ric metadata_file:dir getattr;
allow mi_ric system_dlkm_file:dir getattr;
allow mi_ric linkerconfig_file:dir getattr;
allow mi_ric vendor_shell_exec:file { read getattr execute open execute_no_trans };
allow mi_ric vendor_toolbox_exec:file { read getattr execute open execute_no_trans };
allow mi_ric vendor_file:file execute_no_trans;
allow mi_ric self:capability { chown fsetid sys_resource };
allow mi_ric self:perf_event { open cpu kernel tracepoint read write };
