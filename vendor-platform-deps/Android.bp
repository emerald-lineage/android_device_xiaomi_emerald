// Платформенные библиотеки, которые стоковый vendor.img 305 содержал в разделе, а наш раздел без них
// не грузится. Модуль ничего не делает: он vendor-only, и `required` — единственный способ заставить
// soong собрать vendor-варианты этих библиотек и поставить их в /vendor.
//
// Почему не PRODUCT_PACKAGES: 27.11 проверено на двух прогонах. Для модулей с vendor_available: true
// (все android.hardware.*-ndk, libhidltransport, libhwbinder, libmnl, libdrm, libcodec2_*, ...)
// PRODUCT_PACKAGES ставит только system-вариант: в ninja нет ни одного пути в vendor, интермедиатов
// vendor-варианта тоже нет, а правила в installs-*.mk при этом есть — поэтому и PRODUCT_COPY_FILES
// на те же пути даёт «overriding commands for target». Проверено: libaedv, libladder и ещё 7 модулей
// с vendor: true поставились сразу, остальные 91 — нет.
//
// Почему не блобы из стока: conflicts.py показывает 124 конфликта — платформа держит правило на те же
// пути vendor/lib{,64}. Список собран из аудита DT_NEEDED (scripts/vendor-needed.py в emerald-build):
// 98 модулей, которые ждут 28 бинарников (composer, allocator, audio HAL, camera, sensors, wifi, bt,
// nfc, keymint); 9 из них платформа ставит и сама (vendor: true), остальные 91 без required в раздел
// не попадали.
cc_library_shared {
    name: "emerald_vendor_platform_deps",
    vendor: true,
    srcs: ["empty.c"],
    // Пустой список символов: важен только факт установки в /vendor.
    strip: {
        none: true,
    },
    required: [
        "android.frameworks.stats-V1-ndk",
        "android.hardware.audio.common@5.0",
        "android.hardware.audio.core-V3-ndk",
        "android.hardware.audio.core.sounddose-V3-ndk",
        "android.hardware.audio.effect-V2-ndk",
        "android.hardware.audio.effect-V3-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.bluetooth-V1-ndk",
        "android.hardware.bluetooth.audio-V4-ndk",
        "android.hardware.bluetooth.audio-V5-ndk",
        "android.hardware.bluetooth.audio@2.0",
        "android.hardware.bluetooth.audio@2.1",
        "android.hardware.bluetooth.finder-V1-ndk",
        "android.hardware.bluetooth.ranging-V1-ndk",
        "android.hardware.camera.common-V2-ndk",
        "android.hardware.camera.device-V3-ndk",
        "android.hardware.camera.provider-V3-ndk",
        "android.hardware.camera.provider@2.4",
        "android.hardware.camera.provider@2.5",
        "android.hardware.camera.provider@2.6",
        "android.hardware.gnss-V5-ndk",
        "android.hardware.graphics.common-V5-ndk",
        "android.hardware.graphics.common-V6-ndk",
        "android.hardware.graphics.composer3-V2-ndk",
        "android.hardware.graphics.composer3-V3-ndk",
        "android.hardware.graphics.composer3-V4-ndk",
        "android.hardware.health-V1-ndk",
        "android.hardware.ir-V1-ndk",
        "android.hardware.light-V1-ndk",
        "android.hardware.light-V2-ndk",
        "android.hardware.media.c2-V1-ndk",
        "android.hardware.nfc-V1-ndk",
        "android.hardware.nfc@1.0",
        "android.hardware.power-V4-ndk",
        "android.hardware.power-V6-ndk",
        "android.hardware.radio-V4-ndk",
        "android.hardware.radio.config-V4-ndk",
        "android.hardware.radio.data-V4-ndk",
        "android.hardware.radio.ims-V3-ndk",
        "android.hardware.radio.messaging-V4-ndk",
        "android.hardware.radio.modem-V4-ndk",
        "android.hardware.radio.network-V4-ndk",
        "android.hardware.radio.sap-V1-ndk",
        "android.hardware.radio.sim-V4-ndk",
        "android.hardware.radio.voice-V4-ndk",
        "android.hardware.secure_element-V1-ndk",
        "android.hardware.security.keymint-V3-ndk",
        "android.hardware.security.keymint-V4-ndk",
        "android.hardware.sensors-V2-ndk",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.soundtrigger3-V3-ndk",
        "android.hardware.tetheroffload-V1-ndk",
        "android.hardware.usb-V3-ndk",
        "android.hardware.usb.gadget-V1-ndk",
        "android.hardware.vibrator-V1-ndk",
        "android.hardware.wifi.common-V2-ndk",
        "android.hardware.wifi.hostapd-V3-ndk",
        "android.media.audio.common.types-V4-ndk",
        "lib_android_keymaster_keymint_utils",
        "libaedv",
        "libalsautils",
        "libalsautilsv2",
        "libcodec2_aidl",
        "libcodec2_hidl@1.0",
        "libcodec2_hidl@1.1",
        "libcodec2_hidl@1.2",
        "libcodec2_soft_common",
        "libcppbor_external",
        "libdrm",
        "libflatbuffers-cpp",
        "libgrallocusage",
        "libhidltransport",
        "libhwbinder",
        "libkeymint",
        "libkeymint_remote_prov_support",
        "libkeystore-wifi-hidl",
        "libladder",
        "libmediautils_vendor",
        "libmnl",
        "libnbaio_mono",
        "libsensorndkbridge",
        "libtinyalsav2",
        "libtinycompress",
        "libtrusty",
        "vendor.mediatek.hardware.audio-V1-ndk",
        "vendor.mediatek.hardware.bluetooth.audio-V1-ndk",
        "vendor.mediatek.hardware.bluetooth.audio@2.1",
        "vendor.mediatek.hardware.bluetooth.audio@2.2",
        "vendor.mediatek.hardware.lbs@1.0",
        "vendor.mediatek.hardware.mtkpower-V1-ndk",
        "vendor.mediatek.hardware.mtkpower-V2-ndk",
        "vendor.mediatek.hardware.mtkpower@1.0",
        "vendor.mediatek.hardware.mtkpower@1.1",
        "vendor.mediatek.hardware.mtkpower@1.2",
        "vendor.mediatek.hardware.netdagent@1.0",
    ],
}
