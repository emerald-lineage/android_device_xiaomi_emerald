// The vendor partition is built from the stock 305 blobs (vendor/xiaomi/emerald), not from source. The
// platform still installs a vendor package set of its own (base_vendor, media_vendor, handheld_vendor),
// which either overwrites a stock file with a different build or adds a file the stock image never had.
// A module listed in `overrides` is not installed if the module declaring it is installed, so this phony
// module (part of PRODUCT_PACKAGES in device.mk) drops that set from the vendor image.
//
// PRODUCT_PACKAGES has no "-module" removal syntax (soong receives such a name literally), and a
// filter-out inside a product makefile only sees the packages of that file: product configuration merges
// the inherited lists after the file is parsed.
//
// toybox_vendor, toolbox_vendor, boringssl_self_test.*.rc and the rest of the required-dependency chain
// follow shell_and_utilities_vendor and boringssl_self_test_vendor automatically. The platform policy
// modules are dropped because the stock policy ships in /vendor/etc/selinux and BOARD_VENDOR_SEPOLICY_DIRS
// is empty; the system, system_ext and product policy come from their own product makefiles. passwd/group
// are dropped because the stock image ships them empty (0 bytes) and the source ones have real entries.
phony {
    name: "emerald_vendor_platform_override",
    overrides: [
        "audio.primary.default",
        "boringssl_self_test_vendor",
        "com.android.hardware.cas",
        "dumpsys_vendor",
        "gralloc.default",
        "group_odm",
        "group_vendor",
        "init_vendor",
        "libaudiopreprocessing",
        "libbundlewrapper",
        "libclearkeycasplugin",
        "libdownmix",
        "libdrmclearkeyplugin",
        "libdynproc",
        "libeffectproxy",
        "libeffects",
        "libhapticgenerator",
        "libldnhncr",
        "libreference-ril",
        "libreverbwrapper",
        "libril",
        "libvisualizer",
        "local_time.default",
        "odm-build.prop",
        "passwd_odm",
        "passwd_vendor",
        "power.default",
        "selinux_policy_nonsystem",
        "selinux_policy_odm",
        "selinux_policy_vendor",
        "shell_and_utilities_vendor",
        "vendor_compatibility_matrix.xml",
        "vibrator.default",
    ],
}
